{
  "name": "@movingpro/proplet",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for tenant data: conditions, locations and files.",
  "homepage": "https://github.com/movingpro/proplet#readme",
  "bugs": {
    "url": "https://github.com/movingpro/proplet/issues"
  },
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/movingpro/proplet.git"
  },
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "dev": "node --watch src/node-handler.ts",
    "start": "node src/node-handler.ts",
    "migrate": "sqlite3 proplet.sqlite < migrations/0001_init.sql",
    "format": "oxfmt",
    "lint": "oxlint --type-aware --type-check",
    "test": "node --test --experimental-test-coverage \"src/**/*.spec.ts\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@hono/node-server": "^2.1.8",
    "hono": "^4.13.18",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "tsrs": "^0.25.0-ts7.1.0-beta"
  }
}
